# The ingress: media, images and the bitrate test go to the stream role, everything else
# (WebSocket included) to the api role. Clients vary the case of paths, so the
# match is case-insensitive.
:8080 {
	@stream path_regexp stream (?i)^/(videos/|playback/bitratetest$|items/[^/]+/images(/|$))
	handle @stream {
		reverse_proxy stream:8096 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy api:8096
	}
}
