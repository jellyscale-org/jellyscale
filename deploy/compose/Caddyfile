# The ingress: media, images, file downloads, the bitrate test and the encoding configuration (which jellyfin-web reads
# before an ASS track, and a stream replica answers in an outage) go to the stream role, everything else
# (WebSocket included) to the api role. Clients vary the case of paths, so the
# match is case-insensitive.
#
# Each role has two replicas, listed one by one: Caddy health-checks a listed upstream by its address, so
# one name that resolves to several replicas (a compose --scale) would be one upstream, taken out
# of service whole when one replica drains. Add a line per replica you add. Every block does what
# docs/running.md asks of an ingress: it polls /readyz, stops sending to a replica that answers 503 or
# refuses, and tries a GET that failed before its response header on another replica.
:8080 {
	@stream path_regexp stream (?i)^/(videos/|playback/bitratetest$|system/configuration/encoding$|items/[^/]+/(images(/|$)|download$))
	handle @stream {
		reverse_proxy stream:8096 stream2:8096 {
			flush_interval -1
			health_uri /readyz
			health_interval 1s
			health_timeout 1s
			# A replica killed between two polls is passed over by the next request too.
			fail_duration 10s
			max_fails 1
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retries 3
			lb_retry_match {
				method GET HEAD
			}
		}
	}
	handle {
		reverse_proxy api:8096 api2:8096 {
			health_uri /readyz
			health_interval 1s
			health_timeout 1s
			fail_duration 10s
			max_fails 1
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retries 3
			lb_retry_match {
				method GET HEAD
			}
		}
	}

	# When Postgres has been away from every replica for over 30 seconds they all answer 503 on
	# /readyz and the blocks above find nothing to send to. Requests wait for Postgres on the
	# replicas, so the film plays on once it is back; a 503 from here would stop it. This
	# fallback sends to every replica whatever /readyz says (health_fails is too high to ever
	# mark one down; a killed one is passed over by the retry). The trailing dot gives each replica
	# a second name, because Caddy shares one health state between handlers that name a replica alike.
	handle_errors {
		@noready expression {err.status_code} == 503
		@media path_regexp media (?i)^/(videos/|playback/bitratetest$|system/configuration/encoding$|items/[^/]+/(images(/|$)|download$))
		handle @noready {
			handle @media {
				reverse_proxy stream.:8096 stream2.:8096 {
					flush_interval -1
					health_uri /readyz
					health_interval 1s
					health_fails 100000000
					lb_try_duration 5s
					lb_try_interval 250ms
					lb_retries 3
					lb_retry_match {
						method GET HEAD
					}
				}
			}
			handle {
				reverse_proxy api.:8096 api2.:8096 {
					health_uri /readyz
					health_interval 1s
					health_fails 100000000
					lb_try_duration 5s
					lb_try_interval 250ms
					lb_retries 3
					lb_retry_match {
						method GET HEAD
					}
				}
			}
		}
	}
}
